    "Deine neuesten Fotos sprechen für %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your newest photos point to %@."
          }
        }
      }
    },
    "Albumist kennt die Orte dort noch nicht. Sobald sie bekannt sind, kannst du dein Zuhause bestätigen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumist doesn't know the places there yet. Once it does, you can confirm your home."
          }
        }
      }
    },
    "Albumist ist gerade beschäftigt. Versuch es gleich noch einmal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumist is busy right now. Please try again in a moment."
          }
