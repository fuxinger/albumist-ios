            "value" : "Your albums"
          }
        }
      }
    },
    "Deine Entscheidungen, Alben und der Verlauf liegen als kleine Kopie im Backup deines Geräts. Zuletzt gesichert: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small copy of your decisions, albums and history is part of your device backup. Last saved: %@."
